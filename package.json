{
  "name": "whalesignal",
  "version": "1.0.0",
  "private": true,
  "description": "Track credible Polymarket wallets, reconcile their positions, and surface explainable consensus with forward paper trading.",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "npm run build && tsx server/src/index.ts",
    "serve": "tsx server/src/index.ts",
    "dev": "concurrently -k -n api,web \"tsx watch server/src/index.ts\" \"vite\"",
    "demo": "npm run build && tsx server/src/index.ts --demo",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
