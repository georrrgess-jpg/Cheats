# WhaleSignal configuration. Copy to .env and edit if needed. All values are optional.
# No API keys are required: every Polymarket endpoint used is public.

# Network interface to bind. 127.0.0.1 keeps the dashboard private to this computer.
# Use 0.0.0.0 only behind a password (DASHBOARD_PASSWORD) or a private network.
HOST=127.0.0.1
PORT=8787

# SQLite database file (created automatically).
DB_PATH=./data/whalesignal.db

# Optional HTTP Basic auth for the dashboard + API. Strongly recommended if HOST is not 127.0.0.1.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=change-me

# Polite self-imposed request ceiling to Polymarket (requests per second, all hosts combined per host).
# Polymarket's documented limits are far higher (e.g. 200 req / 10 s on /v2/positions).
REQUESTS_PER_SECOND=4

# Set to 1 to disable the background worker (API + UI only, no tracking).
DISABLE_WORKER=0
